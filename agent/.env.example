# PR1/PR2 服务骨架与显式 Fake demo 不调用真实模型，也不需要模型 API Key。
AGENT_ENVIRONMENT=development
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
AGENT_LOG_LEVEL=INFO
AGENT_READINESS_TIMEOUT_SECONDS=2
AGENT_SHUTDOWN_TIMEOUT_SECONDS=10

# 未配置数据库时 /healthz=200，/readyz=503。
# 仅允许 mysql+asyncmy 协议和 oj_agent Schema。凭据特殊字符需要 URL 编码。
# AGENT_DATABASE_URL=mysql+asyncmy://agent:replace-me@127.0.0.1:3306/oj_agent

# PR2 demo 需显式启用，并先应用 migrations/agent；生产环境禁止 fake。
AGENT_RUNTIME_MODE=disabled
AGENT_CONFIG_MODE=demo
AGENT_DEFAULT_AGENT_KEY=learning_assistant
AGENT_MAX_RUN_SECONDS=30
AGENT_MAX_OUTPUT_CHARS=8000
AGENT_MAX_RUN_EVENTS=1000

# PR3 HTTP Chat；必须同时启用 Runtime、数据库和 Gateway 公钥。
AGENT_CHAT_ENABLED=false
# AGENT_GATEWAY_PUBLIC_KEY_FILE=/path/to/gateway-public.pem
AGENT_GATEWAY_KEY_ID=gateway-internal-2026-09
AGENT_MAX_REQUEST_BYTES=262144
AGENT_MAX_CONCURRENT_RUNS=8
AGENT_PREFLIGHT_TIMEOUT_SECONDS=5
AGENT_SSE_HEARTBEAT_SECONDS=5
AGENT_SSE_WRITE_TIMEOUT_SECONDS=5

# PR4 只读业务 Tools（仍不接入真实模型）；启用时需要 Agent 自有私钥。
# AGENT_BUSINESS_TOOLS_ENABLED=false
# AGENT_AGENT_PRIVATE_KEY_FILE=/path/to/agent-private.pem
# AGENT_AGENT_KEY_ID=agent-internal-2026-10
# AGENT_AGENT_ISSUER=go-oj-agent
# AGENT_AGENT_SUBJECT=agent-service
# AGENT_PROBLEM_SERVICE_ENDPOINT=problem-service:9002
# AGENT_JUDGE_SERVICE_ENDPOINT=judge-service:9003
# AGENT_TOOL_MAX_PAGE_SIZE=50

# PR6 真实模型，必须先导入凭据和 Provider/Model/Agent 配置。
# AGENT_CONFIG_MODE=database
# AGENT_RUNTIME_MODE=model
# AGENT_CREDENTIAL_KEYRING_FILE=/secure/agent/keyring.json
AGENT_PROVIDER_ALLOWED_ORIGINS=["https://www.su8.codes"]
AGENT_PROVIDER_ALLOW_PRIVATE_NETWORK=false
AGENT_MAX_MODEL_CALLS=8
AGENT_MAX_INPUT_TOKENS=32000
AGENT_MAX_OUTPUT_TOKENS=8000
