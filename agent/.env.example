# PR1 只提供服务骨架，不调用模型，也不需要模型 API Key。
AGENT_ENVIRONMENT=development
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
AGENT_LOG_LEVEL=INFO
AGENT_READINESS_TIMEOUT_SECONDS=2
AGENT_SHUTDOWN_TIMEOUT_SECONDS=10

# 未配置数据库时 /healthz=200，/readyz=503。
# 仅允许 mysql+asyncmy 协议和 oj_agent Schema。凭据特殊字符需要 URL 编码。
# AGENT_DATABASE_URL=mysql+asyncmy://agent:replace-me@127.0.0.1:3306/oj_agent
