# 仅用于本地开发。共享或生产环境必须使用独立的高熵密钥与密码。
MYSQL_ROOT_PASSWORD=local-root-password
MYSQL_USER=oj_user
MYSQL_PASSWORD=local-user-password
AUTH_ACCESS_TOKEN_KEY=local-development-access-token-key-change-before-sharing

# 可选端口覆盖。
MYSQL_PORT=3306
REDIS_PORT=6379
USER_GRPC_PORT=9001
GATEWAY_HTTP_PORT=8080

# 测试 Access Token 过期时可覆盖为 5s；本地开发默认 15m。
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# make infra-up 默认启动 Agent，并接通 Gateway；false 仅关闭 Gateway Agent 路由。
AGENT_ENABLED=true
AGENT_ADMIN_ENABLED=true
AGENT_CONFIG_MODE=database
# auto：检测宿主目录 su8.key，有 Key 使用真实 Responses，否则演示。
AGENT_RUNTIME_MODE=auto
# 默认 ~/.config/oj-agent；目录内 su8.key 权限须为 600。
# AGENT_MODEL_KEY_DIR=/absolute/path/to/oj-agent
AGENT_BOOTSTRAP_SU8=true
AGENT_MAX_RUN_SECONDS=120
AGENT_BOOTSTRAP_DEMO=true
AGENT_ADMIN_PROVIDER_KEY=su8
# LangSmith 云导出默认关闭。需要使用时，在未提交的本地 .env 或部署 Secret 中设置密钥。
AGENT_LANGSMITH_EXPORT_ENABLED=false
# LANGSMITH_API_KEY=lsv2_pt_...
# Map JSONL fixture aliases to existing dedicated non-admin user IDs.
# Example: AGENT_EVAL_PRINCIPALS={"student_a":123}
AGENT_EVAL_PRINCIPALS={}
# 本地开发账户在 agent-user.sql 初始化，仅允许访问 oj_agent。
# AGENT_DATABASE_URL=mysql+asyncmy://oj_agent:local-agent-password@mysql:3306/oj_agent

# RAG 向量库仅绑定本机；Embedding 在构建阶段准备固定 BGE 模型。
QDRANT_PORT=6333
