# 仅用于本地开发。共享或生产环境必须使用独立的高熵密钥与密码。
MYSQL_ROOT_PASSWORD=local-root-password
MYSQL_USER=oj_user
MYSQL_PASSWORD=local-user-password
AUTH_ACCESS_TOKEN_KEY=local-development-access-token-key-change-before-sharing

# 可选端口覆盖。
MYSQL_PORT=3306
REDIS_PORT=6379
USER_GRPC_PORT=9001
GATEWAY_HTTP_PORT=8080

# 测试 Access Token 过期时可覆盖为 5s；本地开发默认 15m。
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
