{
  "title": "OJ 系统与判题",
  "uid": "oj-system-overview",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "annotations": {"list": []},
  "templating": {"list": []},
  "panels": [
    {"id": 1, "title": "HTTP 请求速率", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "oj:request_rate:sum5m", "legendFormat": "{{service_name}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqps", "noValue": "无数据"}, "overrides": []}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}},
    {"id": 2, "title": "HTTP 5xx 速率", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "oj:request_error_rate:sum5m", "legendFormat": "{{service_name}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqps", "noValue": "无数据", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 0.1}]}}, "overrides": []}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}},
    {"id": 3, "title": "判题提交与排队 P95", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "oj:judge_submission_rate:sum5m", "legendFormat": "提交/秒", "refId": "A"}, {"expr": "oj:judge_queue_p95_seconds:5m", "legendFormat": "排队 P95 秒", "refId": "B"}], "fieldConfig": {"defaults": {"noValue": "无数据"}, "overrides": [{"matcher": {"id": "byName", "options": "排队 P95 秒"}, "properties": [{"id": "unit", "value": "s"}]}]}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}},
    {"id": 4, "title": "Worker 在途任务", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(oj_judge_worker_in_flight)", "legendFormat": "任务", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "noValue": "无数据"}, "overrides": []}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}},
    {"id": 5, "title": "Contest 缓存 Outbox", "type": "stat", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(oj_contest_cache_outbox_pending)", "legendFormat": "pending", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "noValue": "无数据", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "orange", "value": 1}, {"color": "red", "value": 100}]}}, "overrides": []}, "gridPos": {"h": 5, "w": 8, "x": 0, "y": 16}},
    {"id": 6, "title": "Contest 最老 Outbox 年龄", "type": "stat", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(oj_contest_cache_outbox_oldest_age_seconds)", "legendFormat": "秒", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s", "noValue": "无数据", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "orange", "value": 60}, {"color": "red", "value": 300}]}}, "overrides": []}, "gridPos": {"h": 5, "w": 8, "x": 8, "y": 16}},
    {"id": 7, "title": "采集器导出失败", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "rate(oj_telemetry_export_failure_total[5m])", "legendFormat": "{{service_name}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "cps", "noValue": "无数据"}, "overrides": []}, "gridPos": {"h": 5, "w": 8, "x": 16, "y": 16}},
    {"id": 8, "title": "采集目标状态", "type": "table", "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "up{job=~\"otel-collector|otel-collector-self|contest-service\"}", "format": "table", "instant": true, "refId": "A"}], "fieldConfig": {"defaults": {"noValue": "未知"}, "overrides": []}, "gridPos": {"h": 6, "w": 24, "x": 0, "y": 21}}
  ]
}
